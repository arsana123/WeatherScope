# Both keys are OPTIONAL. Leave them blank and WeatherOps still runs:
#   - weather comes from the free Open-Meteo API (no signup)
#   - the map uses a free dark basemap
#
# Copy this file to ".env" and fill in what you have, then RESTART `npm run dev`
# (Vite only reads .env when it starts).

# OpenWeatherMap: https://home.openweathermap.org/api_keys
# Enables weather map overlays (clouds, rain, wind, ...). For weather data it
# needs a One Call 3.0 subscription - if that's missing the app falls back to Open-Meteo.
VITE_WEATHER_API_KEY=

# MapTiler (free tier, no card): https://cloud.maptiler.com/account/keys/
# Gives the nicer "basic-dark" basemap.
VITE_MAPTILER_API_KEY=
